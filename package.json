{
  "name": "cute-cat-avatars",
  "version": "0.0.1",
  "description": "Cute cats are colorful cats illustrated by Drew Rattana that can be used as profile picture placeholders for live websites or design mock ups.",
  "type": "module",
  "scripts": {
    "dev": "bun wrangler dev",
    "start": "bun src/index.ts",
    "test": "bun test",
    "gen:cats": "bun scripts/generate-cats.ts",
    "predev": "bun run gen:cats",
    "predeploy": "bun run gen:cats",
    "deploy": "bun wrangler deploy"
  },
  "pre-commit": "bun test",
  "repository": {
    "type": "git",
    "url": "git@github.com:Laosing/cute-cat-avatars.git"
  },
  "author": "Drew Rattana",
  "license": "MIT",
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/static": "^1.4.7",
    "elysia": "^1.4.18",
    "elysia-rate-limit": "^4.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251210.0",
    "bun-types": "latest",
    "wrangler": "^4.53.0"
  }
}
